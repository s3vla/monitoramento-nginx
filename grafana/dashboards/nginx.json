          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nginx_connections_waiting",
          "legendFormat": "{{vm}} espera",
          "range": true,
          "instant": false
        }
      ],
      "id": 10
    }
  ]
