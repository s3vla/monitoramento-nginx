            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8F8F8F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^srv-a( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^srv-b( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nginx_connections_active",
          "legendFormat": "{{vm}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Conexões aceitas × processadas (por segundo)",
      "description": "nginx_connections_accepted e nginx_connections_handled são contadores; rate(...[1m]) = conexões por segundo. Se 'aceitas' ficar acima de 'processadas', o Nginx está descartando conexões (limite de recursos).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^lb( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8F8F8F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^srv-a( .*)?$"
            },
            "properties": [
              {
                "id": "color",
