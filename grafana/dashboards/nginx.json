      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Conexões em leitura, escrita e espera",
      "description": "Estado de cada conexão agora (gauges): reading = lendo a requisição do cliente; writing = enviando a resposta (cresce quando o backend demora); waiting = ociosa em keep-alive.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^lb( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8F8F8F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
